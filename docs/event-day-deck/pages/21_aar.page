# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: content
audience: participant
background:
  type: solid
  color: "$paper"
elements:
  - elementId: tag
    elementType: text
    bounds: [64, 40, 400, 16]
    content: {style: "$tag", wrap: false, text: PART 5 · CLOSING}
  - elementId: title
    elementType: text
    bounds: [64, 66, 832, 34]
    content: {style: "$title", fontSize: 30, wrap: false, text: "Closing: the after-action review"}
  - elementId: rule
    elementType: line
    bounds: [64, 116, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$line"}
  - elementId: intro
    elementType: text
    bounds: [64, 136, 832, 22]
    contractRef: aar.intro
    content: {style: "$body", fontSize: 15, text: "<p>Thirty minutes, whole team, led by the operator. The point is the reasoning, not the score.</p>"}
  - elementId: handoff
    elementType: text
    bounds: [64, 178, 832, 72]
    contractRef: exercise_complete.handoff
    content:
      style: "$body"
      fontSize: 15
      text: |
        <p>A complete handoff has three parts: what the records support, what they explicitly do not support, and what you would need in order to close the difference. Teams that hand over all three are the ones the next shift can actually work from.</p>
  - elementId: prompts-head
    elementType: text
    bounds: [64, 278, 832, 16]
    content: {fontSize: 13, bold: true, color: "$slate", wrap: false, text: "THE FIVE QUESTIONS, IN ORDER"}
  - elementId: prompts-rule
    elementType: line
    bounds: [64, 302, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: prompt1
    elementType: text
    bounds: [96, 316, 800, 19]
    contractRef: aar.prompts.0
    content: {fontSize: 15, color: "$ink", wrap: false, text: "Which single finding most changed your assessment, and what changed it?"}
  - elementId: prompt1-num
    elementType: text
    bounds: [64, 316, 30, 19]
    content: {fontSize: 15, bold: true, color: "$amber", wrap: false, text: "1."}
  - elementId: prompt2
    elementType: text
    bounds: [96, 343, 800, 19]
    contractRef: aar.prompts.1
    content: {fontSize: 15, color: "$ink", wrap: false, text: "Where did you find yourself inferring beyond the record, and did the evidence catch it?"}
  - elementId: prompt2-num
    elementType: text
    bounds: [64, 343, 30, 19]
    content: {fontSize: 15, bold: true, color: "$amber", wrap: false, text: "2."}
  - elementId: prompt3
    elementType: text
    bounds: [96, 370, 800, 19]
    contractRef: aar.prompts.2
    content: {fontSize: 15, color: "$ink", wrap: false, text: "What did the collection gap cost you, and how would you have closed it earlier?"}
  - elementId: prompt3-num
    elementType: text
    bounds: [64, 370, 30, 19]
    content: {fontSize: 15, bold: true, color: "$amber", wrap: false, text: "3."}
  - elementId: prompt4
    elementType: text
    bounds: [96, 397, 800, 19]
    contractRef: aar.prompts.3
    content: {fontSize: 15, color: "$ink", wrap: false, text: "The closing ticket wanted three no-answers. Which surprised your team most, and why?"}
  - elementId: prompt4-num
    elementType: text
    bounds: [64, 397, 30, 19]
    content: {fontSize: 15, bold: true, color: "$amber", wrap: false, text: "4."}
  - elementId: prompt5
    elementType: text
    bounds: [96, 424, 800, 19]
    contractRef: aar.prompts.4
    content: {fontSize: 15, color: "$ink", wrap: false, text: "What will the next shift inherit from you that they could actually use?"}
  - elementId: prompt5-num
    elementType: text
    bounds: [64, 424, 30, 19]
    content: {fontSize: 15, bold: true, color: "$amber", wrap: false, text: "5."}
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: "21"}
