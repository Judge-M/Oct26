# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: cover
audience: participant
background:
  type: solid
  color: "$deep"
elements:
  - elementId: ring-outer
    elementType: shape
    bounds: [600, 90, 380, 380]
    shapeName: donut
    adjustments: [4000]
    fill: {type: solid, color: "#3A524B66"}
  - elementId: ring-mid
    elementType: shape
    bounds: [660, 150, 260, 260]
    shapeName: donut
    adjustments: [5000]
    fill: {type: solid, color: "#3A524B88"}
  - elementId: ring-inner
    elementType: shape
    bounds: [720, 210, 140, 140]
    shapeName: donut
    adjustments: [7000]
    fill: {type: solid, color: "#3A524BAA"}
  - elementId: patrol-dot
    elementType: shape
    bounds: [852, 168, 16, 16]
    shapeName: ellipse
    fill: {type: solid, color: "$amber"}
  - elementId: patrol-label
    elementType: text
    bounds: [700, 400, 180, 16]
    content: {fontSize: 13, color: "#C9CFC7", letterSpacing: 2, align: [center, middle], wrap: false, text: PATROL LANTERN}
  - elementId: kicker
    elementType: text
    bounds: [64, 116, 480, 16]
    content: {style: "$tag", wrap: false, text: DEFENSIVE CYBERSECURITY EXERCISE}
  - elementId: title
    elementType: text
    bounds: [64, 148, 560, 116]
    content:
      fontSize: 52
      bold: true
      color: "#F5F2EA"
      lineHeight: 1.1
      text: |
        <p>Operation</p>
        <p>Silent Ridge</p>
  - elementId: rule
    elementType: line
    bounds: [64, 288, 120, 3]
    viewBox: [120, 3]
    points: "0,1.5 120,1.5"
    curve: sharp
    border: {style: solid, width: 3, color: "$amber"}
  - elementId: outcome
    elementType: text
    bounds: [64, 312, 512, 60]
    contractRef: exercise.outcome
    content:
      fontSize: 15
      color: "#C9CFC7"
      text: |
        <p>By the end, your team should be able to say precisely what is supported, precisely what is not, and what you would need in order to close the gap. A correct boundary is a result, not a failure to find one.</p>
  - elementId: classification-label
    elementType: text
    bounds: [64, 394, 200, 15]
    content: {fontSize: 12, bold: true, color: "$amber", wrap: false, text: CLASSIFICATION}
  - elementId: classification
    elementType: text
    bounds: [64, 412, 512, 16]
    contractRef: exercise.classification_line
    content: {fontSize: 13, color: "#C9CFC7", wrap: false, text: FICTIONAL EXERCISE MATERIAL - NOT AN OPERATIONAL ASSESSMENT}
  - elementId: fiction
    elementType: text
    bounds: [64, 456, 512, 36]
    contractRef: boundaries.fiction_repeat
    content:
      fontSize: 12
      lineHeight: 1.4
      color: "#7E877F"
      text: |
        <p>Operation Silent Ridge is fictional. No real organisation, patrol, person, address or adversary is represented.</p>
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: "1"}
