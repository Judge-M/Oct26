# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: final
audience: participant
background:
  type: solid
  color: "$deep"
elements:
  - elementId: ring-outer
    elementType: shape
    bounds: [760, 320, 260, 260]
    shapeName: donut
    adjustments: [5000]
    fill: {type: solid, color: "#3A524B66"}
  - elementId: ring-inner
    elementType: shape
    bounds: [820, 380, 140, 140]
    shapeName: donut
    adjustments: [8000]
    fill: {type: solid, color: "#3A524B99"}
  - elementId: tag
    elementType: text
    bounds: [64, 88, 400, 16]
    content: {style: "$tag", wrap: false, text: YOU'RE READY}
  - elementId: title
    elementType: text
    bounds: [64, 116, 700, 45]
    content: {fontSize: 36, bold: true, color: "#F5F2EA", wrap: false, text: What successful completion looks like}
  - elementId: rule
    elementType: line
    bounds: [64, 190, 120, 3]
    viewBox: [120, 3]
    points: "0,1.5 120,1.5"
    curve: sharp
    border: {style: solid, width: 3, color: "$amber"}
  - elementId: close
    elementType: text
    bounds: [64, 214, 700, 42]
    contractRef: aar.close
    content:
      fontSize: 16
      color: "#C9CFC7"
      text: |
        <p>Success is a defensible handoff, not a complete story. A team that knows precisely what it does not know has done the job.</p>
  - elementId: urls-title
    elementType: text
    bounds: [64, 284, 300, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: YOUR FOUR ADDRESSES}
  - elementId: urls
    elementType: text
    bounds: [64, 312, 700, 22]
    content: {fontSize: 14, color: "#C9CFC7", lineHeight: 1.6, text: "IRIS :8081 · CTFd :8083 · Wazuh :8443 (HTTPS) · Team desktop :8082"}
  - elementId: fiction
    elementType: text
    bounds: [64, 460, 700, 18]
    contractRef: boundaries.fiction_repeat
    content:
      fontSize: 13
      lineHeight: 1.4
      color: "#7E877F"
      text: |
        <p>Operation Silent Ridge is fictional. No real organisation, patrol, person, address or adversary is represented.</p>
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: "22"}
