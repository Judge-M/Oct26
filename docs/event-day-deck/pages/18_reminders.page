# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: content
audience: participant
background:
  type: solid
  color: "$paper"
elements:
  - elementId: tag
    elementType: text
    bounds: [64, 40, 400, 16]
    content: {style: "$tag", wrap: false, text: PART 4 · WORKING RULES}
  - elementId: title
    elementType: text
    bounds: [64, 66, 832, 34]
    content: {style: "$title", fontSize: 30, wrap: false, text: "Reminders: how solo work becomes shared work"}
  - elementId: rule
    elementType: line
    bounds: [64, 116, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$line"}
  - elementId: nothing-card
    elementType: shape
    bounds: [64, 136, 264, 222]
    shapeName: rect
    fill: {type: solid, color: "$palegreen"}
    border: {style: solid, width: 1, color: "$slate"}
  - elementId: nothing-label
    elementType: text
    bounds: [78, 150, 236, 16]
    content: {fontSize: 13, bold: true, color: "$slate", wrap: false, text: NOTHING YOU DO SHOULD CHANGE A SYSTEM}
  - elementId: nothing-rule
    elementType: line
    bounds: [78, 174, 236, 2]
    viewBox: [236, 2]
    points: "0,1.0 236,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: nothing-read_only
    elementType: text
    bounds: [78, 186, 236, 84]
    contractRef: boundaries.read_only
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>Everything in this exercise is read-only. You will not be asked to change a system, and nothing you do should touch one.</p>
  - elementId: shared-card
    elementType: shape
    bounds: [348, 136, 264, 222]
    shapeName: rect
    fill: {type: solid, color: "$palegreen"}
    border: {style: solid, width: 1, color: "$slate"}
  - elementId: shared-label
    elementType: text
    bounds: [362, 150, 236, 16]
    content: {fontSize: 13, bold: true, color: "$slate", wrap: false, text: EVERY ANSWER BECOMES A SHARED FINDING}
  - elementId: shared-rule
    elementType: line
    bounds: [362, 174, 236, 2]
    viewBox: [236, 2]
    points: "0,1.0 236,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: shared-lead
    elementType: text
    bounds: [362, 186, 236, 62]
    contractRef: accepted.lead
    content: {style: "$body", fontSize: 13, text: "<p>Recorded. The finding is on the shared case now, and any team still working can use it.</p>"}
  - elementId: shared-shared
    elementType: text
    bounds: [362, 258, 236, 84]
    contractRef: accepted.shared
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>This finding is visible to every team. That is the design: a correct answer should make the next team faster, not the same amount of work twice.</p>
  - elementId: closed-card
    elementType: shape
    bounds: [632, 136, 264, 222]
    shapeName: rect
    fill: {type: solid, color: "$palegreen"}
    border: {style: solid, width: 1, color: "$slate"}
  - elementId: closed-label
    elementType: text
    bounds: [646, 150, 236, 16]
    content: {fontSize: 13, bold: true, color: "$slate", wrap: false, text: A CLOSED TICKET STAYS ON THE RECORD}
  - elementId: closed-rule
    elementType: line
    bounds: [646, 174, 236, 2]
    viewBox: [236, 2]
    points: "0,1.0 236,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: closed-generic
    elementType: text
    bounds: [646, 186, 236, 84]
    contractRef: ticket_complete.generic
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>Ticket closed. Completed answers and their findings stay on the shared record even if another team takes the ticket next.</p>
  - elementId: hints-label
    elementType: text
    bounds: [64, 384, 832, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: AND IF YOU GET STUCK}
  - elementId: hints-rule
    elementType: line
    bounds: [64, 406, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: hints
    elementType: text
    bounds: [64, 418, 832, 21]
    contractRef: hints.policy
    content: {style: "$body", fontSize: 14, text: "<p>All help is free and none of it costs a point. Hints are written to point at a source, not at a value.</p>"}
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: "18"}
