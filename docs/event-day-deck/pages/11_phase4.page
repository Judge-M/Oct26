# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: content
audience: participant
background:
  type: solid
  color: "$paper"
elements:
  - elementId: tag
    elementType: text
    bounds: [64, 40, 400, 16]
    content: {style: "$tag", wrap: false, text: PART 2 · HOW THE DAY WORKS — PHASE 4 OF 4}
  - elementId: title
    elementType: text
    bounds: [64, 66, 528, 31]
    contractRef: phases.phase-4.title
    content: {style: "$title", fontSize: 27, wrap: false, text: "The document, and the limit of the claim"}
  - elementId: rule
    elementType: line
    bounds: [64, 116, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$line"}
  - elementId: tickets-label
    elementType: text
    bounds: [600, 64, 296, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, align: [right, top], text: TICKETS IN THIS PHASE}
  - elementId: tickets
    elementType: text
    bounds: [600, 82, 296, 16]
    contractRef: phases.phase-4.tickets
    content: {fontSize: 13, bold: true, color: "$slate", align: [right, top], text: T08 · T09 · T19 · T20}
  - elementId: timeframe
    elementType: text
    bounds: [64, 128, 832, 17]
    contractRef: phases.phase-4.timeframe
    content: {style: "$small", wrap: false, text: The converging phase}
  - elementId: purpose-head
    elementType: text
    bounds: [64, 166, 396, 19]
    content: {fontSize: 15, bold: true, color: "$slate", wrap: false, text: PURPOSE}
  - elementId: purpose-rule
    elementType: line
    bounds: [64, 193, 396, 2]
    viewBox: [396, 2]
    points: "0,1.0 396,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: purpose
    elementType: text
    bounds: [64, 205, 396, 67]
    contractRef: phases.phase-4.purpose
    content:
      style: "$body"
      fontSize: 14
      text: |
        <p>Confirm which version left, check what was requested and refused, and then state the boundary of the whole investigation as precisely as the evidence allows.</p>
  - elementId: urgency-head
    elementType: text
    bounds: [500, 166, 396, 19]
    content: {fontSize: 15, bold: true, color: "$amber", wrap: false, text: URGENCY}
  - elementId: urgency-rule
    elementType: line
    bounds: [500, 193, 396, 2]
    viewBox: [396, 2]
    points: "0,1.0 396,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: urgency
    elementType: text
    bounds: [500, 205, 396, 44]
    contractRef: phases.phase-4.urgency
    content:
      style: "$body"
      fontSize: 14
      text: |
        <p>Convergent. These tickets unlock late and deliberately depend on the earlier ones. Do not shortcut them.</p>
  - elementId: action-label
    elementType: text
    bounds: [64, 304, 832, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: WHAT YOU DO HERE}
  - elementId: action-rule
    elementType: line
    bounds: [64, 326, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: action
    elementType: text
    bounds: [64, 338, 832, 47]
    contractRef: phases.phase-4.action
    content:
      style: "$body"
      fontSize: 15
      text: |
        <p>Compare the released version history, verify the transmitted payload against the service catalogue, and write the closing statement with its limits attached.</p>
  - elementId: transition-label
    elementType: text
    bounds: [64, 395, 832, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: AND THEN}
  - elementId: transition-rule
    elementType: line
    bounds: [64, 417, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: transition
    elementType: text
    bounds: [64, 429, 832, 21]
    contractRef: phases.phase-4.transition
    content: {style: "$body", fontSize: 14, text: "<p>The investigation is complete. What follows is the handoff.</p>"}
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: "11"}
