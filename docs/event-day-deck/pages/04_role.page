# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: content
audience: participant
background:
  type: solid
  color: "$paper"
elements:
  - elementId: tag
    elementType: text
    bounds: [64, 40, 400, 16]
    content: {style: "$tag", wrap: false, text: PART 1 · THE INCIDENT}
  - elementId: title
    elementType: text
    bounds: [64, 66, 832, 34]
    content: {style: "$title", fontSize: 30, wrap: false, text: "Your role, and what you are not"}
  - elementId: rule
    elementType: line
    bounds: [64, 116, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$line"}
  - elementId: role-soc-analyst-name
    elementType: text
    bounds: [64, 140, 264, 19]
    contractRef: roles.soc-analyst.name
    content: {fontSize: 15, bold: true, color: "$slate", wrap: false, text: Investigation analyst}
  - elementId: role-soc-analyst-rule
    elementType: line
    bounds: [64, 169, 264, 2]
    viewBox: [264, 2]
    points: "0,1.0 264,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: role-soc-analyst-duty
    elementType: text
    bounds: [64, 185, 264, 62]
    contractRef: roles.soc-analyst.duty
    content: {style: "$body", fontSize: 13, text: "<p>Claim a ticket, work the evidence named in it, and answer that ticket's questions in CTFd.</p>"}
  - elementId: role-soc-analyst-authority-label
    elementType: text
    bounds: [64, 271, 264, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, text: YOU DECIDE}
  - elementId: role-soc-analyst-authority
    elementType: text
    bounds: [64, 293, 264, 62]
    contractRef: roles.soc-analyst.authority
    content: {style: "$body", fontSize: 13, text: "<p>You decide what the records support. You do not decide what happened in the real world.</p>"}
  - elementId: role-soc-analyst-not-label
    elementType: text
    bounds: [64, 379, 264, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, text: YOU DO NOT}
  - elementId: role-soc-analyst-not
    elementType: text
    bounds: [64, 401, 264, 84]
    contractRef: roles.soc-analyst.not
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>You do not contain, isolate or disable anything, and you do not reset anything. Every change in this exercise is already made by someone else and documented as such.</p>
  - elementId: role-record-keeper-name
    elementType: text
    bounds: [348, 140, 264, 19]
    contractRef: roles.record-keeper.name
    content: {fontSize: 15, bold: true, color: "$slate", wrap: false, text: Shared-record keeper}
  - elementId: role-record-keeper-rule
    elementType: line
    bounds: [348, 169, 264, 2]
    viewBox: [264, 2]
    points: "0,1.0 264,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: role-record-keeper-duty
    elementType: text
    bounds: [348, 185, 264, 41]
    contractRef: roles.record-keeper.duty
    content: {style: "$body", fontSize: 13, text: "<p>Make sure every answer your team posts is legible to the teams who read it afterwards.</p>"}
  - elementId: role-record-keeper-authority-label
    elementType: text
    bounds: [348, 250, 264, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, text: YOU DECIDE}
  - elementId: role-record-keeper-authority
    elementType: text
    bounds: [348, 272, 264, 62]
    contractRef: roles.record-keeper.authority
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>A correct answer becomes a shared finding in the IRIS case automatically. Teams build on each other here; that is deliberate.</p>
  - elementId: role-record-keeper-not-label
    elementType: text
    bounds: [348, 358, 264, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, text: YOU DO NOT}
  - elementId: role-record-keeper-not
    elementType: text
    bounds: [348, 380, 264, 62]
    contractRef: roles.record-keeper.not
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>You do not edit another team's finding, and you do not post an answer you have not actually verified from the evidence.</p>
  - elementId: role-boundary-keeper-name
    elementType: text
    bounds: [632, 140, 264, 19]
    contractRef: roles.boundary-keeper.name
    content: {fontSize: 15, bold: true, color: "$slate", wrap: false, text: Boundary keeper}
  - elementId: role-boundary-keeper-rule
    elementType: line
    bounds: [632, 169, 264, 2]
    viewBox: [264, 2]
    points: "0,1.0 264,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$slate"}
  - elementId: role-boundary-keeper-duty
    elementType: text
    bounds: [632, 185, 264, 41]
    contractRef: roles.boundary-keeper.duty
    content: {style: "$body", fontSize: 13, text: "<p>Say out loud what a result does not prove, every time.</p>"}
  - elementId: role-boundary-keeper-authority-label
    elementType: text
    bounds: [632, 250, 264, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, text: YOU DECIDE}
  - elementId: role-boundary-keeper-authority
    elementType: text
    bounds: [632, 272, 264, 41]
    contractRef: roles.boundary-keeper.authority
    content: {style: "$body", fontSize: 13, text: "<p>This is the single most valuable thing your team can do.</p>"}
  - elementId: role-boundary-keeper-not-label
    elementType: text
    bounds: [632, 337, 264, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, text: YOU DO NOT}
  - elementId: role-boundary-keeper-not
    elementType: text
    bounds: [632, 359, 264, 62]
    contractRef: roles.boundary-keeper.not
    content:
      style: "$body"
      fontSize: 13
      text: |
        <p>You do not soften a finding to make it sound cautious, and you do not stop a finding to make it sound conclusive.</p>
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: "4"}
