    elementType: text
    bounds: [64, 40, 400, 16]
    content: {style: "$tag", wrap: false, text: PART 2 · HOW THE DAY WORKS — PHASE 3 OF 4}
  - elementId: title
    elementType: text
    bounds: [64, 66, 528, 31]
    contractRef: phases.phase-3.title
    content: {style: "$title", fontSize: 27, wrap: false, text: The account and its session}
  - elementId: rule
    elementType: line
    bounds: [64, 116, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$line"}
  - elementId: tickets-label
    elementType: text
    bounds: [600, 64, 296, 14]
    content: {fontSize: 11, bold: true, color: "$amber", wrap: false, align: [right, top], text: TICKETS IN THIS PHASE}
  - elementId: tickets
    elementType: text
    bounds: [600, 82, 296, 16]
    contractRef: phases.phase-3.tickets
    content: {fontSize: 13, bold: true, color: "$slate", align: [right, top], text: T06 · T07 · T10 · T11 · T12}
  - elementId: timeframe
    elementType: text
