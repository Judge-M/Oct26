# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: content
audience: facilitator
background:
  type: solid
  color: "$deep"
elements:
  - elementId: facilitator-banner
    elementType: shape
    bounds: [0, 0, 960, 52]
    shapeName: rect
    fill: {type: solid, color: "$amber"}
  - elementId: facilitator-banner-text
    elementType: text
    bounds: [0, 12, 960, 22]
    content: {fontSize: 18, bold: true, color: "#16211E", align: [center, middle], wrap: false, text: FACILITATOR ONLY — DO NOT PROJECT}
  - elementId: title
    elementType: text
    bounds: [64, 92, 832, 32]
    content: {fontSize: 26, bold: true, color: "#F5F2EA", wrap: false, text: "Facilitator appendix: pause, inject, delay, recover"}
  - elementId: pause-card
    elementType: shape
    bounds: [64, 140, 396, 164]
    shapeName: rect
    fill: {type: solid, color: "#22302C"}
    border: {style: solid, width: 1, color: "$amber"}
  - elementId: pause-label
    elementType: text
    bounds: [78, 152, 368, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: PAUSE THE CLOCK}
  - elementId: pause-rule
    elementType: line
    bounds: [78, 180, 368, 2]
    viewBox: [368, 2]
    points: "0,1.0 368,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: pause-command
    elementType: text
    bounds: [78, 190, 368, 15]
    content: {fontSize: 11, color: "#C9CFC7", lineHeight: 1.4, text: python -m ridge.deploy pause --profile event-profile.json --runtime R}
  - elementId: pause-note
    elementType: text
    bounds: [78, 215, 368, 54]
    content:
      fontSize: 12
      color: "#C9CFC7"
      lineHeight: 1.4
      text: |
        For a floor interruption, a failed login sweep or a room-wide announcement. Announce the pause before you stop, and resume deliberately.
  - elementId: inject-card
    elementType: shape
    bounds: [500, 140, 396, 164]
    shapeName: rect
    fill: {type: solid, color: "#22302C"}
    border: {style: solid, width: 1, color: "$amber"}
  - elementId: inject-label
    elementType: text
    bounds: [514, 152, 368, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: INJECT BRIEFING}
  - elementId: inject-rule
    elementType: line
    bounds: [514, 180, 368, 2]
    viewBox: [368, 2]
    points: "0,1.0 368,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: inject-command
    elementType: text
    bounds: [514, 190, 368, 15]
    content: {fontSize: 11, color: "#C9CFC7", lineHeight: 1.4, text: "python -m ridge.cli announce --operator EXCON --text \"...\""}
  - elementId: inject-note
    elementType: text
    bounds: [514, 215, 368, 54]
    content:
      fontSize: 12
      color: "#C9CFC7"
      lineHeight: 1.4
      text: |
        Injects are authored on the day, not in this deck. Send text only: no answers, no adversary names, nothing a team has not already earned.
  - elementId: delay-card
    elementType: shape
    bounds: [64, 320, 396, 164]
    shapeName: rect
    fill: {type: solid, color: "#22302C"}
    border: {style: solid, width: 1, color: "$amber"}
  - elementId: delay-label
    elementType: text
    bounds: [78, 332, 368, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: SYNCHRONISATION DELAY}
  - elementId: delay-rule
    elementType: line
    bounds: [78, 360, 368, 2]
    viewBox: [368, 2]
    points: "0,1.0 368,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: delay-command
    elementType: text
    bounds: [78, 370, 368, 15]
    content: {fontSize: 11, color: "#C9CFC7", lineHeight: 1.4, text: "wait about ten seconds, then re-check"}
  - elementId: delay-note
    elementType: text
    bounds: [78, 395, 368, 54]
    content:
      fontSize: 12
      color: "#C9CFC7"
      lineHeight: 1.4
      text: |
        Scoring and finding publication run in the background. A finding that has not appeared yet is a delay, not a fault. Do not recover a ticket over it.
  - elementId: recover-card
    elementType: shape
    bounds: [500, 320, 396, 164]
    shapeName: rect
    fill: {type: solid, color: "#22302C"}
    border: {style: solid, width: 1, color: "$amber"}
  - elementId: recover-label
    elementType: text
    bounds: [514, 332, 368, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: RECOVER A STUCK TICKET}
  - elementId: recover-rule
    elementType: line
    bounds: [514, 360, 368, 2]
    viewBox: [368, 2]
    points: "0,1.0 368,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: recover-command
    elementType: text
    bounds: [514, 370, 368, 33]
    content: {fontSize: 11, color: "#C9CFC7", lineHeight: 1.4, text: "python -m ridge.cli recover T03 --generation 1 --operator EXCON --reason \"...\""}
  - elementId: recover-note
    elementType: text
    bounds: [514, 413, 368, 54]
    content:
      fontSize: 12
      color: "#C9CFC7"
      lineHeight: 1.4
      text: |
        Only when a ticket is unusable, not when it is hard. Points already earned on it stay earned. Read docs/runbook.md before recovering.
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: F2}
