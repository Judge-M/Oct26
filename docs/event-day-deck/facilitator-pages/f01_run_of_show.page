# Generated by python -m ridge.deck_narrative --write. Scenario wording is
# rendered from assets/scenario-narrative-v1.json; do not retype it here.
pageType: content
audience: facilitator
background:
  type: solid
  color: "$deep"
elements:
  - elementId: facilitator-banner
    elementType: shape
    bounds: [0, 0, 960, 52]
    shapeName: rect
    fill: {type: solid, color: "$amber"}
  - elementId: facilitator-banner-text
    elementType: text
    bounds: [0, 12, 960, 22]
    content: {fontSize: 18, bold: true, color: "#16211E", align: [center, middle], wrap: false, text: FACILITATOR ONLY — DO NOT PROJECT}
  - elementId: title
    elementType: text
    bounds: [64, 92, 832, 32]
    content: {fontSize: 26, bold: true, color: "#F5F2EA", wrap: false, text: "Facilitator appendix: run of show"}
  - elementId: intro
    elementType: text
    bounds: [64, 140, 832, 44]
    content:
      fontSize: 14
      lineHeight: 1.5
      color: "#C9CFC7"
      text: |
        <p>Project the participant deck only. The detailed procedure lives in docs/event-day-commands.md and docs/runbook.md; this slide records which slide goes up when, so a facilitator covering the room is never guessing.</p>
  - elementId: order-head
    elementType: text
    bounds: [64, 212, 832, 16]
    content: {fontSize: 13, bold: true, color: "$amber", wrap: false, text: SLIDE ORDER}
  - elementId: order-rule
    elementType: line
    bounds: [64, 238, 832, 2]
    viewBox: [832, 2]
    points: "0,1.0 832,1.0"
    curve: sharp
    border: {style: solid, width: 2, color: "$amber"}
  - elementId: order1
    elementType: text
    bounds: [64, 250, 832, 16]
    content: {fontSize: 13, color: "#C9CFC7", wrap: false, text: "1-5   incident brief, role and urgency"}
  - elementId: order2
    elementType: text
    bounds: [64, 276, 832, 16]
    content: {fontSize: 13, color: "#C9CFC7", wrap: false, text: "6-7   how the day works, and the four investigation phases"}
  - elementId: order3
    elementType: text
    bounds: [64, 302, 832, 16]
    content: {fontSize: 13, color: "#C9CFC7", wrap: false, text: "8-11  one slide per phase — show the phase a team is in, not all four"}
  - elementId: order4
    elementType: text
    bounds: [64, 328, 832, 16]
    content: {fontSize: 13, color: "#C9CFC7", wrap: false, text: 12-17 the four-tab setup and the tools}
  - elementId: order5
    elementType: text
    bounds: [64, 354, 832, 16]
    content: {fontSize: 13, color: "#C9CFC7", wrap: false, text: "18-22 reminders, ground rules, troubleshooting, AAR and close"}
  - elementId: boundary
    elementType: text
    bounds: [64, 396, 832, 38]
    contractRef: boundaries.no_credentials
    content:
      fontSize: 13
      lineHeight: 1.4
      color: "#C9CFC7"
      text: |
        <p>No credential, address, key or infrastructure detail is displayed to participants at any point. If a screen appears to show one, that is a defect: report it to the operator.</p>
  - elementId: footer
    elementType: text
    bounds: [64, 505, 700, 15]
    content: {fontSize: 12, color: "#7E877F", wrap: false, text: OPERATION SILENT RIDGE — EXERCISE ONLY}
  - elementId: pagenum
    elementType: text
    bounds: [880, 505, 40, 15]
    content: {fontSize: 12, color: "#7E877F", align: [right, top], wrap: false, text: F1}
