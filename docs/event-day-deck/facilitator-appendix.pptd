# The .page sources are authoritative. This project file is generated by
# python -m ridge.deck_narrative --write from the scenario contract.
version: v2
title: Operation Silent Ridge — Facilitator Appendix (do not project)
audience: facilitator
size: [960, 540]
theme:
  colors:
    paper: "#F5F2EA"
    ink: "#1A1E24"
    slate: "#27403B"
    deep: "#16211E"
    amber: "#C77D1F"
    muted: "#6B6E6A"
    line: "#D8D2C4"
    palegreen: "#E4E9E2"
  textStyles:
    tag:
      fontSize: 13
      color: "$amber"
      bold: true
      letterSpacing: 3
    title:
      fontSize: 30
      color: "$ink"
      bold: true
    body:
      fontSize: 16
      color: "$ink"
      lineHeight: 1.5
    small:
      fontSize: 12
      color: "$muted"
      lineHeight: 1.4
    stepnum:
      fontSize: 44
      color: "$amber"
      bold: true
participantProject: event-day-deck.pptd
pages:
  - facilitator-pages/f01_run_of_show.page
  - facilitator-pages/f02_callouts.page
