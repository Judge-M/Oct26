FROM python:3.12.10-slim
WORKDIR /opt/silent-ridge
COPY ridge ./ridge
COPY bounded_http.py .
# The controller runs `python -m ridge.cli preflight` here, so the approved
# narrative contract travels with it. No expanded/, and therefore no answers.
COPY assets/scenario-narrative-v1.json ./assets/scenario-narrative-v1.json
USER 10001:10001
CMD ["python", "-m", "ridge.service", "--host", "0.0.0.0"]
