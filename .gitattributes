*.sh text eol=lf
Dockerfile* text eol=lf
# Deliberately scoped: do not accidentally version live databases or exports.
/assets/large/** filter=lfs diff=lfs merge=lfs -text
# Parked VM desktop: optional Hyper-V/qcow2 path, excluded from distributions.
/assets/vm-desktop/** filter=lfs diff=lfs merge=lfs -text
/assets/**/*.json text eol=lf
/expanded/binary/*.c text eol=lf
/deployment/expanded/build-history/*.txt -text
